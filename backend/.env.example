# ─────────────────────────────────────────────────────────────
#  .env.example  —  AI Voice Interview System
#  Copy this file to .env and fill in your real values.
#  NEVER commit your real .env file to version control!
# ─────────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────────────────────
PORT=5055
NODE_ENV=production

# ── Database (MongoDB) ────────────────────────────────────────
# MongoDB connection string (Local or MongoDB Atlas)
# Example Atlas: mongodb+srv://<user>:<password>@cluster.mongodb.net/interview_db?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/ai_interview_db

# ── Security (REQUIRED) ───────────────────────────────────────
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_strong_random_secret_here_at_least_64_chars

# ── Frontend URL (REQUIRED in production) ─────────────────────
# Set to your deployed frontend domain. Comma-separated for multiple origins.
# Example: https://myapp.vercel.app,https://myapp.com
FRONTEND_URL=http://localhost:5600

# ── Google Gemini AI (REQUIRED) ───────────────────────────────
# Get your key from: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# ── Groq AI (Optional — fallback when Gemini is rate-limited) ─
# Get your key from: https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here

# ── Google OAuth (Optional — enables "Sign in with Google") ───
# Create credentials at: https://console.cloud.google.com/
# Authorized redirect URIs must include: https://yourdomain.com/api/auth/google/callback
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# ── GitHub OAuth (Optional — enables "Sign in with GitHub") ───
# Create an OAuth App at: https://github.com/settings/developers
# Callback URL must be: https://yourdomain.com/api/auth/github/callback
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here
